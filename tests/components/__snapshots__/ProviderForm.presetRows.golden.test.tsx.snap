              "text",
              "image",
            ],
            "model": "deepseek-flash",
            "reasoningLevels": [
              "low",
              "high",
              "max",
            ],
          },
          {
            "contextWindow": 1048576,
            "displayName": "DeepSeek V4 Pro",
            "inputModalities": [
              "text",
            ],
            "model": "deepseek-v4-pro",
            "reasoningLevels": [
              "low",
